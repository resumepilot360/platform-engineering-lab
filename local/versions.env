# Pinned versions for the local lab. Single source of truth for scripts.
# Bump deliberately; record the change in docs/decisions or the commit message.
K3D_MIN_VERSION=v5.9.0
K3S_IMAGE=rancher/k3s:v1.35.5-k3s1
KUBECTL_VERSION=v1.35.10
CILIUM_CHART_VERSION=1.20.4
CILIUM_CLI_MIN_VERSION=v0.20.1

CLUSTER_NAME=platform-lab
KUBE_CONTEXT=k3d-platform-lab
API_PORT=6550
INGRESS_HTTP_PORT=8081
INGRESS_HTTPS_PORT=8443

# Registry lives outside the cluster lifecycle so images survive rebuilds.
REGISTRY_NAME=registry.localhost
REGISTRY_CONTAINER=k3d-registry.localhost
REGISTRY_PORT=5001

# Smoke-test images (mirrored into the local registry by scripts/seed-registry.sh)
WHOAMI_IMAGE=docker.io/traefik/whoami:v1.11.0
BUSYBOX_IMAGE=docker.io/library/busybox:1.37.0
