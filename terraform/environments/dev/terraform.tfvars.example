# Copy to terraform.tfvars (gitignored). Values are identifiers, not secrets,
# but stay out of Git because they are account-specific.
aws_account_id                 = "123456789012"
persona_trusted_principal_arns = ["arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_PlatformEngineer_0000000000000000"]
breakglass_principal_arns      = ["arn:aws:iam::123456789012:root"]
terraform_apply_role_arn       = "arn:aws:iam::123456789012:role/platform-lab/platform-lab-tf-apply"
permissions_boundary           = "arn:aws:iam::123456789012:policy/platform-lab/platform-lab-workload-boundary"
api_public_access_cidrs        = ["203.0.113.10/32"]
alert_emails                   = ["platform-alerts@example.com"]
